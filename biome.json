{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "includes": ["**/*.js", "**/*.json", "**/*.css", "**/*.html", "!**/exifr.full.umd.js"],
    "ignoreUnknown": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noEmptyBlockStatements": "off"
      },
      "complexity": {
        "noForEach": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "crlf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2
    }
  }
}
